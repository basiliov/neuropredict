#!/usr/bin/env python3
import os
import platform
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV_DIR = ROOT / ".venv"
LOG_DIR = ROOT / "logs"
LOG_DIR.mkdir(exist_ok=True)


def ensure_env():
    if not VENV_DIR.exists():
        print("[INFO] Creating virtual environment...")
        subprocess.run([sys.executable, "-m", "venv", str(VENV_DIR)], check=True)

    if platform.system() == "Windows":
        py = VENV_DIR / "Scripts" / "python.exe"
    else:
        py = VENV_DIR / "bin" / "python"

    if not py.exists():
        raise FileNotFoundError(f"Virtual environment Python not found: {py}")

    return py


def install_python_deps(python_bin: Path):
    print("[INFO] Installing Python dependencies...")
    subprocess.run([str(python_bin), "-m", "pip", "install", "--upgrade", "pip"], check=True)
    subprocess.run([str(python_bin), "-m", "pip", "install", "-r", str(ROOT / "requirements.txt")], check=True)


def ensure_node_modules():
    if shutil.which("npm") is None:
        raise RuntimeError("npm not found. Install Node.js 20+ before running the frontend.")

    web_dir = ROOT / "web"
    if not (web_dir / "node_modules").exists():
        print("[INFO] Installing frontend dependencies...")
        subprocess.run(["npm", "install"], cwd=str(web_dir), check=True)


def create_env_file_if_missing():
    env_file = ROOT / ".env"
    example = ROOT / ".env.example"
    if not env_file.exists() and example.exists():
        print("[INFO] Creating .env from .env.example")
        env_file.write_text(example.read_text(), encoding="utf-8")


def start_backend(python_bin: Path):
    backend_log = LOG_DIR / "backend.log"
    print("[INFO] Starting backend on http://127.0.0.1:8000")
    cmd = [
        str(python_bin),
        "-m",
        "uvicorn",
        "app.api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
    ]
    return subprocess.Popen(cmd, cwd=str(ROOT), stdout=backend_log.open("ab"), stderr=subprocess.STDOUT, text=False)


def start_frontend():
    frontend_log = LOG_DIR / "frontend.log"
    print("[INFO] Starting frontend on http://127.0.0.1:5173")
    cmd = ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
    return subprocess.Popen(cmd, cwd=str(ROOT / "web"), stdout=frontend_log.open("ab"), stderr=subprocess.STDOUT, text=False)


def wait_for_http(url: str, timeout_seconds: int = 40):
    start = time.time()
    while time.time() - start < timeout_seconds:
        try:
            import urllib.request
            with urllib.request.urlopen(url, timeout=3) as resp:
                if resp.status in (200, 204):
                    return True
        except Exception:
            time.sleep(1)
    return False


def main():
    create_env_file_if_missing()
    python_bin = ensure_env()
    install_python_deps(python_bin)
    ensure_node_modules()

    backend_proc = start_backend(python_bin)
    frontend_proc = start_frontend()

    print("\n[READY]")
    print("Backend: http://127.0.0.1:8000")
    print("Frontend: http://127.0.0.1:5173")
    print("Swagger: http://127.0.0.1:8000/docs")
    print("Press Ctrl+C to stop both processes.\n")

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n[INFO] Stopping servers...")
        backend_proc.terminate()
        frontend_proc.terminate()
        try:
            backend_proc.wait(timeout=10)
            frontend_proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            backend_proc.kill()
            frontend_proc.kill()
        print("[INFO] NeuroPredict stopped.")


if __name__ == "__main__":
    main()
